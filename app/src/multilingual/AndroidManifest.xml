<?xml version="1.0" encoding="utf-8"?>
<!-- TellWell Multilingual: languages the user adds (Hindi for now) download their own models from TellWell's model
     release, in both builds. The internet is used only for that, and nothing is uploaded. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- A download runs as a foreground task with a progress notification, so locking the phone doesn't stop it. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />

    <application>
        <service
            android:name=".LanguageDownloadService"
            android:exported="false"
            android:foregroundServiceType="dataSync" />
    </application>
</manifest>
